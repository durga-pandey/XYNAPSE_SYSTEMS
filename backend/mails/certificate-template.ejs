<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Certificate</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Raleway', sans-serif;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #e8e8e8;
        }

        .certificate-wrapper {
            width: 100%;
            height: 100%;
            background: white;
            padding: 20px;
            position: relative;
        }

        /* Logo ko wrapper ke corner mein fix kar diya */
        .header {
            position: absolute;
            top: 30px;
            left: 50px;
            z-index: 20;
        }

        .outer-border {
            border: 2px solid #C9A84C;
            height: 100%;
            padding: 15px;
            position: relative;
        }

        .inner-border {
            border: 1px solid #C9A84C;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            /* Sab kuch center mein rahega */
            gap: 20px;
            /* Elements ke beech space */
            padding: 40px 60px;
            position: relative;
        }

        .watermark {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 350px;
            color: #002B5B;
            opacity: 0.05;
            z-index: 0;
        }

        .ribbon-container {
            position: absolute;
            top: 0;
            right: 40px;
            z-index: 10;
        }

        .blue-ribbon {
            width: 100px;
            height: 150px;
            background: #0a3e79;
            clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 85%, 0 100%);
            display: flex;
            justify-content: center;
            padding-top: 15px;
        }

        .main-title {
            font-family: 'Cinzel', serif;
            font-size: 55px;
            color: #002B5B;
            z-index: 1;
        }

        .student-name {
            font-family: 'Great Vibes', cursive;
            font-size: 60px;
            color: #002B5B;
            border-bottom: 2px solid #eee;
            margin: 10px 0;
            z-index: 1;
            text-align: center;
            width: 80%;
        }

        .details-section {
            display: flex;
            justify-content: center;
            gap: 100px;
            margin: 20px 0;
            z-index: 1;
        }

        .footer-row {
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            z-index: 1;
            margin-top: 20px;
        }

        .line {
            border-top: 2px solid #C9A84C;
            margin-top: 5px;
            width: 150px;
        }
    </style>
</head>

<body>
    <div class="certificate-wrapper">
        <div class="header"><img src="<%= logoSrc %>" style="height: 100px;"></div>

        <div class="outer-border">
            <div class="inner-border">
                <div class="watermark">★</div>

                <div class="ribbon-container">
                    <div class="blue-ribbon">
                        <img src="https://png.pngtree.com/png-vector/20220202/ourmid/pngtree-blank-gold-certificate-with-red-ribbon-png-image_4376623.png"
                            style="width: 60px; height: 60px;">
                    </div>
                </div>

                <h1 class="main-title">CERTIFICATE</h1>
                <p
                    style="letter-spacing: 4px; color: #444; border-top: 1px solid #C9A84C; width: 300px; text-align: center;">
                    OF COMPLETION</p>

                <p style="font-family: 'Playfair Display'; font-style: italic; margin-top: 10px;">Proudly Certify that
                </p>
                <div class="student-name">
                    <%= certificate.metadata.studentName %>
                </div>

                <p style="text-align: center; color: #555; max-width: 80%;">has successfully completed the <b>
                        <%= certificate.metadata.courseTitle %>
                    </b> program and demonstrated Grade <b>
                        <%= certificate.metadata.grade %>
                    </b> performance.</p>

                <div class="details-section">
                    <div>
                        <h4>DURATION</h4>
                        <p>
                            <%= certificate.metadata.duration %>
                        </p>
                    </div>
                    <div>
                        <h4>GRADE</h4>
                        <p>
                            <%= certificate.metadata.grade %>
                        </p>
                    </div>
                </div>

                <div class="footer-row">
                    <div>
                        <div style="font-family: 'Great Vibes'; font-size: 24px;">Director Sign</div>
                        <div class="line"></div>
                        <p style="font-size: 11px;">COMPANY DIRECTOR</p>
                    </div>
                    <div>
                        <p>
                            <%= issueDate %>
                        </p>
                        <div class="line"></div>
                        <p style="font-size: 9px;">ISSUED DATE</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>